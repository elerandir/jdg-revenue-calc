{
  "$schema": "https://schema.tauri.app/config/2.json",
  "productName": "Kalkulator JDG",
  "version": "1.0.0",
  "identifier": "pl.jdg.kalkulator",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Kalkulator przychodów JDG",
        "width": 1280,
        "height": 900,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Polish", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "category": "Office"
    }
  }
}
